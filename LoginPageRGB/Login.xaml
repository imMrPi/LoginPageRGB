<Window x:Class="LoginPageRGB.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginPageRGB"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800" ResizeMode="NoResize" ShowInTaskbar="True" FontFamily="Arial Rounded MT Bold"  WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush x:Name="BackgroundImage" ImageSource="Images/bg.jpg"/>
    </Window.Background>
    <Grid>
        <!-- Border for Login -->
        <Border x:Name="LoginBorder" Width="300" Height="320" BorderThickness="1" Visibility="Visible">
            <Border.Background>
                <SolidColorBrush Opacity="0.5" Color="#FF292A2D"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.4"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Foreground="white" Text="Login" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,20"/>
                <Label Grid.Row="1" Width="200" Height="30" Margin="0 0 10 25" Content="Email" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Rounded MT Bold"/>
                <TextBox x:Name="Email" Grid.Row="1" Width="200" Height="30" Margin="0,10"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Background="Transparent" BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 15 0 0" Foreground="White"/>
                <Label Grid.Row="2" Width="200" Height="30" Margin="0 10 10 25" Content="Password" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <PasswordBox x:Name="Passwords" Grid.Row="2" Width="200" Height="30" Margin="0,10"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Background="Transparent" BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 15 0 0" Foreground="White" FontFamily="Arial Rounded MT Bold"/>
                <CheckBox Grid.Row="3" Margin="20 5 0 0"/>
                <Label Height="30" Content="Remember Me" Grid.Row="3" Margin="35 0 0 119" Foreground="white"/>
                <Label x:Name="ForgotPass" MouseDoubleClick="ForgotPass_MouseDoubleClick" Height="30" Content="Forgot Password?" Grid.Row="3" Margin="170 0 0 120" Foreground="white"/>

                <StackPanel Grid.Row="3" Margin="0 30 0 0">
                    <Button x:Name="LoginBtn" Click="LoginBtn_Click" Grid.Row="3" Content="Login" Foreground="Black" Width="100" Height="30"
        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,-10"
        MouseEnter="LoginBtn_MouseEnter" MouseLeave="LoginBtn_MouseLeave">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                <GradientStop Color="#FF23F4FC" Offset="0"/>
                                <GradientStop Color="#FFF529D7" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="SignUpInLoginPage" Click="SignUpInLoginPage_Click" Grid.Row="3" Content="Sign Up" Foreground="Black" Width="100" Height="30" Background="white"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border  x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Border for Sign Up -->
        <Border x:Name="SignUpBorder" Width="300" Height="320" BorderThickness="1" Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Opacity="0.5" Color="#FF292A2D"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.4"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Foreground="white" Text="Sign Up" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,20"/>
                <Label Grid.Row="1" Width="200" Height="30" Margin="0 0 10 25" Content="New Email" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Rounded MT Bold"/>
                <TextBox x:Name="NewEmail" Grid.Row="1" Width="200" Height="30" Margin="0,10"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Background="Transparent" BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 15 0 0" Foreground="White"/>
                <Label Grid.Row="2" Width="200" Height="30" Margin="0 10 10 25" Content="New Password" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <PasswordBox x:Name="NewPassword" Grid.Row="2" Width="200" Height="30" Margin="0,10"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Background="Transparent" BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 15 0 0" Foreground="White" FontFamily="Arial Rounded MT Bold"/>
                <Button x:Name="SignUpBtn" Click="SignUpBtn_Click" Grid.Row="3" Content="Sign Up" Foreground="Black" Width="100" Height="30"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,-10"
                      MouseEnter="SignUpBtn_MouseEnter"  MouseLeave="SignUpBtn_MouseLeave">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#FF23F4FC" Offset="0"/>
                            <GradientStop Color="#FFF529D7" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="LoginInSignUpPage" Click="LoginInSignUpPage_Click"  Grid.Row="3" Content="Login" Foreground="Black" Width="100" Height="30" Background="white"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,-20">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border  x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Border for Forgot Password -->
        <Border x:Name="ForgotPassword" BorderThickness="1" Visibility="Collapsed" Width="300" Height="320" >
            <Border.Background>
                <SolidColorBrush Opacity="0.5" Color="#FF292A2D"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.4"/>
            </Border.BorderBrush>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Foreground="white" Text="You Forgot Your Pass?" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <Label Grid.Row="1" Width="200" Height="30" Margin="100 0 10 25" Content="Choose Method" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Rounded MT Bold"/>
                <CheckBox x:Name="NumberMethod" Click="NumberMethod_Click" Grid.Row="1" Margin="40 30 0 0"  Foreground="White">
                    <TextBlock Text="Number" VerticalAlignment="Center" Margin="-2 2 0 0"/>
                </CheckBox>
                <CheckBox  x:Name="EmailMethod" Click="EmailMethod_Click"  Grid.Row="1" Margin="230 30 0 0"  Foreground="White" Panel.ZIndex="2">
                    <TextBlock Text="Email" VerticalAlignment="Center" Margin="-55 2 0 0"/>
                </CheckBox>
                <StackPanel x:Name="NumberPanel" Grid.Row="2" Visibility="Collapsed">
                    <Label Grid.Row="2" Width="200" Height="30" Margin="0 10 10 25" Content="Enter Number" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Width="200" Height="30" Margin="0,-50,0,0"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Background="Transparent" BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 15 0 0" Foreground="White" FontFamily="Arial Rounded MT Bold"/>
                </StackPanel>
                <StackPanel x:Name="EmailPanel" Grid.Row="2" Visibility="Visible">
                    <Label Grid.Row="2" Width="200" Height="30" Margin="0 10 10 25" Content="Enter Email" Foreground="white"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Width="200" Height="30" Margin="0,-50,0,0"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Background="Transparent" BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 15 0 0" Foreground="White" FontFamily="Arial Rounded MT Bold"/>
                </StackPanel>

                <Button x:Name="SendCodeBtn" Click="SendCodeBtn_Click"  Grid.Row="3" Content="Send Code" Foreground="Black" Width="100" Height="30"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,-10"
                      MouseEnter="SendCodeBtn_MouseEnter"  MouseLeave="SendCodeBtn_MouseLeave">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#FF23F4FC" Offset="0"/>
                            <GradientStop Color="#FFF529D7" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="LoginInForgotPage" Click="LoginInForgotPage_Click"  Grid.Row="3" Content="Login" Foreground="Black" Width="100" Height="30" Background="white"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,-20">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border  x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
            </Grid>
        </Border>
    </Grid>
</Window>
